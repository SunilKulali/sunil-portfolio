# Resend email notifications (server-side only)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM="Portfolio <your-verified-sender@example.com>"
NOTIFY_TO=your_email@example.com

# Optional CORS and portfolio URL settings
ALLOWED_ORIGINS=https://your-portfolio.example
SITE_URL=https://your-portfolio.example/

# AI chatbot (server-side only)
ANTHROPIC_API_KEY=your_anthropic_api_key
CHAT_MODEL=claude-haiku-5-5
